# ===========================================
# SoftwareICO Environment Variables
# Copy this file: cp .env-sample .env
# ===========================================

# ----- PostgreSQL -----
POSTGRES_DB=softwareico
POSTGRES_USER=softwareico
POSTGRES_PASSWORD=db-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----- Django -----
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:8000/api
