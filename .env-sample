# ===========================================
# SoftwareICO Environment Variables
# Copy this file: cp .env-sample .env
# ===========================================

# ----- PostgreSQL -----
POSTGRES_DB=softwareico
POSTGRES_USER=softwareico
POSTGRES_PASSWORD=db-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----- Django -----
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- CSRF -----
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ----- Security -----
DJANGO_SECURE_SSL_REDIRECT=True

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Email (Resend SMTP) -----
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_your_api_key_here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=contact@softwareico.com
CONTACT_EMAIL_TO=

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:8000/api
